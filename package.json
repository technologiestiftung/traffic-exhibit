{
  "name": "traffic-exhibit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start-all": "bash start_all.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=web-app\"",
    "stop": "pkill -f 'vite|nodemon|ts-node.*server.ts|npm.*dev' || true",
    "stop-service": "sudo systemctl stop traffic-exhibit.service && pkill -f 'hourly-data-processor' || true",
    "process-data-hourly": "node scripts/hourly-data-processor.js",
    "stop-hourly": "pkill -f 'hourly-data-processor' || true",
    "prettier": "concurrently \"npm run prettier --write --workspace=api\" \"npm run prettier --write --workspace=web-app\"",
    "prettier:ci": "concurrently \"npm run prettier:ci --workspace=api\" \"npm run prettier:ci --workspace=web-app\"",
    "build": "npm run build --workspace=web-app",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"apps/web-app/src/**/*.{ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technologiestiftung/traffic-exhibit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/technologiestiftung/traffic-exhibit/issues"
  },
  "homepage": "https://github.com/technologiestiftung/traffic-exhibit#readme",
  "description": "Interactive exhibit (Berliner Platte) that matches physical traffic block compositions with real Berlin street data via YOLO detection and Telraam sensors.",
  "devDependencies": {
    "@technologiestiftung/eslint-config": "^0.4.0",
    "@turf/turf": "^7.2.0",
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.4.0",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "concurrently": "9.2.1",
    "eslint": "9.11.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-geo": "3.1.1",
    "date-fns": "4.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "node-fs": "^0.1.7",
    "prettier": "3.6.2",
    "zustand": "^5.0.8"
  }
}
